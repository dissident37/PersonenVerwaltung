@*
    Das ist die Startseite. Sie zeigt die Liste aller Personen, hat ein Suchfeld
    und erlaubt es, Name und Vorname direkt in der Tabelle zu ändern.
    Die Daten holt sie nicht selbst aus der Datenbank, sondern über den Helfer
    PersonApiService, der sie bei der API anfragt.
    (Alles, was mit @ beginnt, ist C#-Code mitten im HTML.)
*@

@* Die folgenden Zeilen mit @ müssen jeweils allein stehen, darum die Erklärungen darüber. *@
@* Diese Seite ist unter der Adresse "/" erreichbar. *@
@page "/"
@using PersonenVerwaltung.UI.Services
@* Holt den Helfer, der mit der API spricht, in die Seite. *@
@inject PersonApiService Api
@* Holt den Helfer zum Wechseln der Seite (Navigation). *@
@inject NavigationManager Nav

@* Setzt den Titel im Browser-Tab. *@
<PageTitle>Personenverwaltung</PageTitle>

<h1>Personenverwaltung</h1>

<div class="search-bar">
    @* Das Suchfeld ist mit "searchName" verbunden: was der Nutzer tippt, landet sofort dort. *@
    <input type="text"
           placeholder="Name oder Vorname suchen..."
           @bind="searchName"
           @bind:event="oninput" />
    @* Klick auf den Knopf ruft die Methode LoadPersonen auf. *@
    <button @onclick="LoadPersonen">Personen laden</button>
</div>

@* Je nach Zustand wird etwas anderes angezeigt: erst "lädt", dann ein Fehler,
   dann "nichts gefunden", und sonst die Tabelle. *@
@if (isLoading)
{
    <p>Wird geladen...</p>
}
else if (errorMessage != null)
{
    <p class="error">@errorMessage</p>
}
else if (personen.Count == 0 && hasLoaded)
{
    <p>Keine Personen gefunden.</p>
}
else if (personen.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Vorname</th>
                <th>Geburtsdatum</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @* Für jede Person in der Liste eine Tabellenzeile erzeugen. *@
            @foreach (var p in personen)
            {
                @* Ein Klick auf die Zeile öffnet die Detailseite dieser Person. *@
                <tr @onclick="() => OpenDetail(p.Id)" style="cursor:pointer">
                    <td>
                        @* Wird gerade DIESE Zeile bearbeitet? Dann ein Eingabefeld zeigen, sonst nur den Text. *@
                        @if (editingId == p.Id)
                        {
                            @* stopPropagation: der Klick ins Feld soll NICHT auch die Zeile (Detail öffnen) auslösen. *@
                            <input @bind="editName" @onclick:stopPropagation="true" />
                        }
                        else
                        {
                            @p.Name
                        }
                    </td>
                    <td>
                        @if (editingId == p.Id)
                        {
                            <input @bind="editVorname" @onclick:stopPropagation="true" />
                        }
                        else
                        {
                            @p.Vorname
                        }
                    </td>
                    @* Datum deutsch anzeigen: Tag.Monat.Jahr. *@
                    <td>@p.Geburtsdatum.ToString("dd.MM.yyyy")</td>
                    @* Klicks in dieser Spalte nicht an die Zeile weitergeben. *@
                    <td @onclick:stopPropagation="true">
                        @if (editingId == p.Id)
                        {
                            @* Während des Bearbeitens: Sichern oder Abbrechen. *@
                            <button @onclick="() => SavePerson(p.Id)">Sichern</button>
                            <button @onclick="CancelEdit">Abbrechen</button>
                        }
                        else
                        {
                            @* Sonst: Bearbeiten starten. *@
                            <button @onclick="() => StartEdit(p)">Bearbeiten</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Ab hier kommt der C#-Teil der Seite: die Variablen (der Zustand) und die Methoden (das Verhalten). *@
@code {
    // Der Zustand der Seite:
    private string searchName = string.Empty;          // der aktuelle Suchtext.
    private List<PersonListItem> personen = new();      // die geladenen Personen (am Start eine leere Liste).
    private bool isLoading;                              // ist gerade etwas am Laden?
    private bool hasLoaded;                              // wurde schon mindestens einmal geladen?
    private string? errorMessage;                        // ein Fehlertext, oder leer wenn alles ok ist.

    // Hilfswerte für das Bearbeiten direkt in der Tabelle:
    private int? editingId;                             // Nummer der Zeile, die gerade bearbeitet wird; leer = keine.
    private string editName = string.Empty;            // Zwischenspeicher für den getippten Namen.
    private string editVorname = string.Empty;         // Zwischenspeicher für den getippten Vornamen.

    // Holt die Personen über den Helfer und kümmert sich dabei um Lade-Anzeige und Fehler.
    // Wird beim Klick auf "Personen laden" und nach dem Speichern aufgerufen.
    private async Task LoadPersonen()
    {
        isLoading = true;        // Lade-Anzeige einschalten.
        errorMessage = null;     // alten Fehler löschen.
        hasLoaded = false;
        // Falls beim Laden etwas schiefgeht, fangen wir den Fehler ab, statt die Seite abstürzen zu lassen.
        try
        {
            personen = await Api.GetPersonenAsync(searchName);
            hasLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Laden: {ex.Message}";
        }
        finally
        {
            // Dieser Teil läuft immer – egal ob es geklappt hat oder nicht. Lade-Anzeige wieder aus.
            isLoading = false;
        }
    }

    // Wechselt zur Detailseite der angeklickten Person – aber nur, wenn die Zeile nicht gerade bearbeitet wird.
    private void OpenDetail(int id)
    {
        if (editingId != id)
        {
            Nav.NavigateTo($"/persons/{id}");
        }
    }

    // Startet das Bearbeiten einer Zeile und füllt die Eingabefelder mit den aktuellen Werten vor.
    private void StartEdit(PersonListItem p)
    {
        editingId = p.Id;
        editName = p.Name;
        editVorname = p.Vorname;
    }

    // Bricht das Bearbeiten ab.
    private void CancelEdit() => editingId = null;

    // Speichert die geänderten Werte über die API und lädt danach die Liste neu.
    private async Task SavePerson(int id)
    {
        var success = await Api.UpdatePersonAsync(id, editName, editVorname);
        if (success)
        {
            editingId = null;        // Bearbeiten beenden ...
            await LoadPersonen();    // ... und die Liste frisch laden.
        }
        else
        {
            errorMessage = "Fehler beim Speichern.";
        }
    }
}
