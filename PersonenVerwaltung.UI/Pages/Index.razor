@*
    Startseite (Route "/") der Blazor-Server-UI. Zeigt die Personenliste, bietet eine
    Namenssuche und ermöglicht die Inline-Bearbeitung von Name und Vorname. Der Datenzugriff
    erfolgt ausschließlich über den PersonApiService (HTTP), nicht direkt gegen die Datenbank.
*@

@* Direktiven müssen jeweils auf einer eigenen Zeile stehen. *@
@page "/"
@using PersonenVerwaltung.UI.Services
@inject PersonApiService Api
@inject NavigationManager Nav

<PageTitle>Personenverwaltung</PageTitle>

<h1>Personenverwaltung</h1>

<div class="search-bar">
    @* Zwei-Wege-Bindung an searchName; oninput aktualisiert bei jedem Tastendruck. *@
    <input type="text"
           placeholder="Name oder Vorname suchen..."
           @bind="searchName"
           @bind:event="oninput" />
    <button @onclick="LoadPersonen">Personen laden</button>
</div>

@* Bedingte Darstellung nach Zustand: Laden, Fehler, leeres Ergebnis, Tabelle. *@
@if (isLoading)
{
    <p>Wird geladen...</p>
}
else if (errorMessage != null)
{
    <p class="error">@errorMessage</p>
}
else if (personen.Count == 0 && hasLoaded)
{
    <p>Keine Personen gefunden.</p>
}
else if (personen.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Vorname</th>
                <th>Geburtsdatum</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in personen)
            {
                @* Klick auf die Zeile öffnet die Detailseite; das Lambda übergibt die Id. *@
                <tr @onclick="() => OpenDetail(p.Id)" style="cursor:pointer">
                    <td>
                        @if (editingId == p.Id)
                        {
                            @* stopPropagation verhindert, dass der Klick die Detailnavigation auslöst. *@
                            <input @bind="editName" @onclick:stopPropagation="true" />
                        }
                        else
                        {
                            @p.Name
                        }
                    </td>
                    <td>
                        @if (editingId == p.Id)
                        {
                            <input @bind="editVorname" @onclick:stopPropagation="true" />
                        }
                        else
                        {
                            @p.Vorname
                        }
                    </td>
                    <td>@p.Geburtsdatum.ToString("dd.MM.yyyy")</td>
                    <td @onclick:stopPropagation="true">
                        @if (editingId == p.Id)
                        {
                            <button @onclick="() => SavePerson(p.Id)">Sichern</button>
                            <button @onclick="CancelEdit">Abbrechen</button>
                        }
                        else
                        {
                            <button @onclick="() => StartEdit(p)">Bearbeiten</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // Komponentenzustand.
    private string searchName = string.Empty;          // An das Suchfeld gebundener Suchbegriff.
    private List<PersonListItem> personen = new();      // Aktuell geladene Personen.
    private bool isLoading;                              // Aktiv während eines Ladevorgangs.
    private bool hasLoaded;                              // Mindestens einmal geladen (steuert "Keine Personen gefunden").
    private string? errorMessage;                        // Fehlermeldung oder null.

    // Zustand der Inline-Bearbeitung.
    private int? editingId;                             // Id der aktuell bearbeiteten Zeile; null = keine.
    private string editName = string.Empty;            // Zwischenspeicher für den bearbeiteten Namen.
    private string editVorname = string.Empty;         // Zwischenspeicher für den bearbeiteten Vornamen.

    /// <summary>
    /// Lädt die Personen über den API-Service und pflegt Lade- und Fehlerzustand.
    /// Wird beim Klick auf "Personen laden" und nach dem Speichern aufgerufen.
    /// </summary>
    private async Task LoadPersonen()
    {
        isLoading = true;
        errorMessage = null;
        hasLoaded = false;
        try
        {
            personen = await Api.GetPersonenAsync(searchName);
            hasLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Laden: {ex.Message}";
        }
        finally
        {
            // finally garantiert das Zurücksetzen der Lade-Anzeige in jedem Fall.
            isLoading = false;
        }
    }

    /// <summary>Navigiert zur Detailseite der Person, sofern deren Zeile nicht bearbeitet wird.</summary>
    /// <param name="id">Id der angeklickten Person.</param>
    private void OpenDetail(int id)
    {
        if (editingId != id)
        {
            Nav.NavigateTo($"/persons/{id}");
        }
    }

    /// <summary>Startet die Bearbeitung einer Zeile und füllt die Eingabefelder vor.</summary>
    /// <param name="p">Die zu bearbeitende Person.</param>
    private void StartEdit(PersonListItem p)
    {
        editingId = p.Id;
        editName = p.Name;
        editVorname = p.Vorname;
    }

    /// <summary>Bricht die Bearbeitung ab.</summary>
    private void CancelEdit() => editingId = null;

    /// <summary>Speichert die geänderten Werte über die API und lädt die Liste anschließend neu.</summary>
    /// <param name="id">Id der zu speichernden Person.</param>
    private async Task SavePerson(int id)
    {
        var success = await Api.UpdatePersonAsync(id, editName, editVorname);
        if (success)
        {
            editingId = null;
            await LoadPersonen();
        }
        else
        {
            errorMessage = "Fehler beim Speichern.";
        }
    }
}
