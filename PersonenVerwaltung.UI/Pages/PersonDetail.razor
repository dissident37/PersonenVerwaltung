@*
    Detailseite (Route "/persons/{Id:int}") einer einzelnen Person. Zeigt die Stammdaten
    sowie die zugehörigen Anschriften und Telefonnummern. Die Id stammt aus der Route; die
    Daten werden in OnInitializedAsync über den PersonApiService (HTTP) geladen.
*@

@* Direktiven müssen jeweils auf einer eigenen Zeile stehen. *@
@page "/persons/{Id:int}"
@using PersonenVerwaltung.UI.Services
@inject PersonApiService Api
@inject NavigationManager Nav

<PageTitle>Personendetails</PageTitle>

<button @onclick="GoBack">← Zurück</button>

@* Bedingte Darstellung nach Zustand: Laden, nicht gefunden, Daten. *@
@if (isLoading)
{
    <p>Wird geladen...</p>
}
else if (person == null)
{
    <p>Person nicht gefunden.</p>
}
else
{
    <h1>@person.Vorname @person.Name</h1>
    <p><strong>Geburtsdatum:</strong> @person.Geburtsdatum.ToString("dd.MM.yyyy")</p>
    @* NameUppercase ist optional und wird nur bei vorhandenem Wert angezeigt. *@
    @if (!string.IsNullOrEmpty(person.NameUppercase))
    {
        <p><strong>Name (Groß):</strong> @person.NameUppercase</p>
    }

    <h2>Anschriften</h2>
    @if (person.Anschriften.Count == 0)
    {
        <p>Keine Anschriften vorhanden.</p>
    }
    else
    {
        <ul>
            @foreach (var a in person.Anschriften)
            {
                <li>@a.Strasse @a.Hausnummer, @a.Postleitzahl @a.Ort</li>
            }
        </ul>
    }

    <h2>Telefonnummern</h2>
    @if (person.Telefonverbindungen.Count == 0)
    {
        <p>Keine Telefonnummern vorhanden.</p>
    }
    else
    {
        <ul>
            @foreach (var t in person.Telefonverbindungen)
            {
                <li>@t.Nummer</li>
            }
        </ul>
    }
}

@code {
    /// <summary>Aus der Route gebundener Primärschlüssel der anzuzeigenden Person.</summary>
    [Parameter]
    public int Id { get; set; }

    // Voll qualifiziert, da der Komponentenname mit dem record PersonDetail kollidiert.
    private PersonenVerwaltung.UI.Services.PersonDetail? person;
    private bool isLoading = true;        // Beim Aufbau wird sofort geladen.

    /// <summary>
    /// Blazor-Lifecycle-Methode: lädt einmalig beim Initialisieren der Komponente die
    /// Detaildaten von der API.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        person = await Api.GetPersonDetailAsync(Id);
        isLoading = false;
    }

    /// <summary>Navigiert zurück zur Startseite.</summary>
    private void GoBack() => Nav.NavigateTo("/");
}
